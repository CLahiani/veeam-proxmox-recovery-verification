{
  "Veeam": {
    "VbrServer": "vbr.example.local",
    "VbrPort": 9419,
    "VbrApiVersion": "1.3-rev2",
    "NodeCredentialsName": "root@pve-node01",
    "TargetServerName": ""
  },
  "Proxmox": {
    "ApiHost": "localhost",
    "ApiPort": 8006,
    "Node": "",
    "MountRoot": "/run/media/Veeam.Mount.Disks"
  },
  "Target": {
    "IsolatedBridge": "vmbr1",
    "IsolatedVlanTag": 4000,
    "OverlayStoragePath": "/var/lib/vz/images/rv-overlays",
    "VmNamePrefix": "rv-",
    "VmIdRangeStart": 9900
  },
  "VmDefaults": {
    "Memory": 4096,
    "Cores": 2,
    "Cpu": "host",
    "Machine": "q35",
    "Bios": "seabios",
    "ScsiHw": "virtio-scsi-pci",
    "OsType": "l26",
    "Agent": 1,
    "EfiStorage": ""
  },
  "VmOverrides": {
    "SRV-WIN01": { "OsType": "win11", "Bios": "ovmf", "EfiStorage": "local-lvm", "Memory": 8192 },
    "SRV-AD01":  { "OsType": "win11", "Bios": "ovmf", "EfiStorage": "local-lvm", "Memory": 8192, "Cores": 4 }
  },
  "Isolation": {
    "SwitchIsolationConfirmed": false
  },
  "Thresholds": {
    "MaxRestorePointAgeHours": 30,
    "MaxBootMinutes": 20,
    "GuestAgentTimeoutMinutes": 10,
    "PublishTimeoutMinutes": 15,
    "PollIntervalSeconds": 15
  },
  "AppChecks": {
    "*": [
      { "Type": "GuestExec", "Command": "systemctl is-system-running --wait || true", "ExpectedOutput": "running|degraded", "Label": "systemd up" }
    ],
    "SRV-AD01": [
      { "Type": "GuestExec", "Shell": "powershell", "Command": "(Get-Service NTDS,DNS,Kdc | Where-Object Status -ne Running | Measure-Object).Count", "ExpectedOutput": "^0", "Label": "AD DS, DNS, KDC running" },
      { "Type": "GuestExec", "Shell": "powershell", "Command": "(Resolve-DnsName example.local -Server 127.0.0.1 -DnsOnly | Measure-Object).Count", "ExpectedOutput": "^[1-9]", "Label": "DNS zone answers" }
    ],
    "SRV-FILE01": [
      { "Type": "GuestExec", "Shell": "powershell", "Command": "(Get-Service LanmanServer).Status", "ExpectedOutput": "Running", "Label": "SMB server" }
    ],
    "SRV-WEB01": [
      { "Type": "GuestExec", "Command": "curl -sk -o /dev/null -w '%{http_code}' https://localhost/health", "ExpectedOutput": "^200", "Label": "Health endpoint" }
    ],
    "SRV-SQL01": [
      { "Type": "GuestExec", "Shell": "powershell", "Command": "(Get-Service MSSQLSERVER).Status", "ExpectedOutput": "Running", "Label": "SQL Server service" }
    ],
    "SRV-LEGACY01": [
      { "Type": "Tcp", "Port": 22, "Label": "SSH (from this host, needs a route to the isolated VLAN)" }
    ]
  }
}
